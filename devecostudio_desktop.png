#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
visual_locator.py
视觉定位核心模块 / Visual Locating Core Module

功能 / Features:
  - OCR文字定位 (Tesseract)         / OCR text location
  - 图像模板匹配 (OpenCV)           / Image template matching
  - 混合定位策略                     / Hybrid locate strategy
  - 自动重试机制                     / Auto-retry mechanism
  - 截图工具                         / Screenshot utility

依赖 / Dependencies:
  pip install pytesseract pillow opencv-python pyautogui pywin32
  Tesseract binary: https://github.com/UB-Mannheim/tesseract/wiki

用法示例 / Usage:
  from visual_locator import VisualLocator
  vl = VisualLocator()
  x, y = vl.find_text("确定")           # OCR 找文字
  x, y = vl.find_template("btn.png")    # 模板匹配找图标
  x, y = vl.locate("保存", retries=3)   # 混合定位
"""

import os
import sys
import time
import logging
from typing import Optional, Tuple, List

import pytesseract
from PIL import Image, ImageGrab
import cv2
import numpy as np
import pyautogui

# ────────────────────────────────────────────────
# 配置区 / Configuration
# ────────────────────────────────────────────────

# 如果 tesseract.exe 不在 PATH，请修改为实际路径
# If tesseract.exe is not in PATH, set the actual path below
TESSERACT_CMD = r"D:\Tesseract-OCR\tesseract.exe"
if os.path.exists(TESSERACT_CMD):
    pytesseract.pytesseract.tesseract_cmd = TESSERACT_CMD

# 截图保存目录 / Screenshot save directory
SCREENSHOT_DIR = os.path.join(os.path.dirname(os.path.abspath(__file__)), "screenshots")
os.makedirs(SCREENSHOT_DIR, exist_ok=True)

# 日志设置 / Logging setup
logging.basicConfig(
    level=logging.INFO,
    format="%(asctime)s [%(levelname)s] %(message)s",
    datefmt="%H:%M:%S",
)
log = logging.getLogger("VisualLocator")


# ────────────────────────────────────────────────
# 主类 / Main Class
# ────────────────────────────────────────────────

class VisualLocator:
    """
    视觉定位器 / Visual Locator
    组合 OCR + 模板匹配，提供统一的坐标查找接口。
    Combines OCR + template matching for a unified coordinate lookup interface.
    """

    def __init__(
        self,
        lang: str = "chi_sim+eng",
        match_threshold: float = 0.8,
        retry_interval: float = 1.0,
    ):
        """
        参数 / Parameters:
          lang              - tesseract 语言包，中英: 'chi_sim+eng'
          match_threshold   - 模板匹配置信阈值 [0,1]，越高越严格
          retry_interval    - 重试间隔秒数
        """
        self.lang = lang
        self.match_threshold = match_threshold
        self.retry_interval = retry_interval

    # ── 截图工具 / Screenshot ──────────────────────

    def screenshot(
        self,
        region: Optional[Tuple[int, int, int, int]] = None,
        save: bool = False,
        filename: str = "",
    ) -> Image.Image:
        """
        截取当前屏幕（或指定区域）。
        Capture current screen or a sub-region.

        region: (left, top, width, height)  None = 全屏
        save:   是否保存文件 / whether to save file
        filename: 保存文件名（默认带时间戳）
        返回 PIL.Image
        """
        if region is not None:
            left, top, w, h = region
            img = ImageGrab.grab(bbox=(left, top, left + w, top + h))
        else:
            img = ImageGrab.grab()

        if save:
            ts = time.strftime("%Y%m%d_%H%M%S")
            fn = filename or f"screenshot_{ts}.png"
            path = os.path.join(SCREENSHOT_DIR, fn)
            img.save(path)
            log.info(f"截图已保存 / Screenshot saved: {path}")

        return img

    # ── OCR 文字定位 / OCR Text Locate ────────────

    def find_text(
        self,
        text: str,
        region: Optional[Tuple[int, int, int, int]] = None,
        lang: Optional[str] = None,
        preprocess: bool = True,
    ) -> Optional[Tuple[int, int]]:
        """
        用 OCR 在屏幕上找到指定文字，返回其中心坐标 (x, y)。
        Locate text on screen via OCR, return center (x, y) or None.

        text:       要查找的文字 / text to find
        region:     搜索区域 (left, top, w, h)，None = 全屏
        preprocess: 是否对截图做预处理增强 / preprocess image for better OCR
        """
        img = self.screenshot(region=region)
        if preprocess:
            img = self._preprocess(img)

        data = pytesseract.image_to_data(
            img,
            lang=lang or self.lang,
            output_type=pytesseract.Output.DICT,
        )

        offset_x = region[0] if region else 0
        offset_y = region[1] if region else 0

        for i, word in enumerate(data["text"]):
            if text.lower() in word.lower():
                x = data["left"][i] + data["width"][i] // 2 + offset_x
                y = data["top"][i] + data["height"][i] // 2 + offset_y
                log.info(f"OCR 找到 '{text}' 于 ({x}, {y})")
                return (x, y)

        log.warning(f"OCR 未找到文字: '{text}'")
        return None

    def find_all_text(
        self,
        text: str,
        region: Optional[Tuple[int, int, int, int]] = None,
        lang: Optional[str] = None,
    ) -> List[Tuple[int, int]]:
        """
        返回所有匹配文字的中心坐标列表。
        Return all center coordinates matching the text.
        """
        img = self.screenshot(region=region)
        img = self._preprocess(img)
        data = pytesseract.image_to_data(
            img,
            lang=lang or self.lang,
            output_type=pytesseract.Output.DICT,
        )
        results = []
        offset_x = region[0] if region else 0
        offset_y = region[1] if region else 0
        for i, word in enumerate(data["text"]):
            if text.lower() in word.lower():
                x = data["left"][i] + data["width"][i] // 2 + offset_x
                y = data["top"][i] + data["height"][i] // 2 + offset_y
                results.append((x, y))
        log.info(f"找到 {len(results)} 处 '{text}'")
        return results

    # ── 图像模板匹配 / Template Matching ──────────

    def find_template(
        self,
        template_path: str,
        region: Optional[Tuple[int, int, int, int]] = None,
        threshold: Optional[float] = None,
    ) -> Optional[Tuple[int, int]]:
        """
        在屏幕上用模板匹配找到图片，返回中心坐标。
        Find a template image on screen, return center (x, y) or None.

        template_path: 模板图片路径 / path to template image
        threshold:     匹配置信度 [0,1] / confidence threshold
        """
        thresh = threshold or self.match_threshold
        img = self.screenshot(region=region)
        screen_np = cv2.cvtColor(np.array(img), cv2.COLOR_RGB2BGR)
        template = cv2.imread(template_path)
        if template is None:
            log.error(f"无法读取模板图片: {template_path}")
            return None

        result = cv2.matchTemplate(screen_np, template, cv2.TM_CCOEFF_NORMED)
        _, max_val, _, max_loc = cv2.minMaxLoc(result)
        log.info(f"模板匹配置信度: {max_val:.3f} (阈值: {thresh})")

        if max_val >= thresh:
            h, w = template.shape[:2]
            cx = max_loc[0] + w // 2 + (region[0] if region else 0)
            cy = max_loc[1] + h // 2 + (region[1] if region else 0)
            log.info(f"模板匹配成功，中心: ({cx}, {cy})")
            return (cx, cy)

        log.warning(f"模板匹配置信度不足: {max_val:.3f} < {thresh}")
        return None

    # ── 混合定位 / Hybrid Locate ──────────────────

    def locate(
        self,
        target: str,
        template_path: Optional[str] = None,
        region: Optional[Tuple[int, int, int, int]] = None,
        retries: int = 3,
        strategy: str = "auto",
    ) -> Optional[Tuple[int, int]]:
        """
        混合定位：优先模板匹配，失败则用 OCR，带自动重试。
        Hybrid locate: try template first, fallback to OCR, with retries.

        target:        查找目标文字（OCR用）/ text for OCR
        template_path: 模板图片路径（可选）/ template image path (optional)
        region:        搜索区域 / search region
        retries:       最大重试次数 / max retry count
        strategy:      'auto'|'ocr'|'template'
        """
        for attempt in range(1, retries + 1):
            log.info(f"[{attempt}/{retries}] 定位中: '{target}'")
            pos = None

            if strategy in ("auto", "template") and template_path:
                pos = self.find_template(template_path, region=region)

            if pos is None and strategy in ("auto", "ocr"):
                pos = self.find_text(target, region=region)

            if pos:
                return pos

            if attempt < retries:
                log.info(f"等待 {self.retry_interval}s 后重试... / Retrying...")
                time.sleep(self.retry_interval)

        log.error(f"定位失败，已重试 {retries} 次: '{target}'")
        return None

    # ── 内部预处理 / Internal Preprocessing ───────

    @staticmethod
    def _preprocess(img: Image.Image) -> Image.Image:
        """
        对截图做灰度+二值化处理以提升 OCR 精度。
        Convert to grayscale + binarize to boost OCR accuracy.
        """
        gray = img.convert("L")
        arr = np.array(gray)
        # 自适应阈值 / Adaptive threshold
        _, binary = cv2.threshold(arr, 0, 255, cv2.THRESH_BINARY + cv2.THRESH_OTSU)
        return Image.fromarray(binary)


# ── 便捷单例 / Convenience singleton ─────────────
_default_locator = None


def get_locator(**kwargs) -> VisualLocator:
    """获取默认 VisualLocator 单例 / Get default singleton."""
    global _default_locator
    if _default_locator is None:
        _default_locator = VisualLocator(**kwargs)
    return _default_locator


if __name__ == "__main__":
    # 快速测试 / Quick test
    vl = VisualLocator()
    print("截图中... / Taking screenshot...")
    img = vl.screenshot(save=True)
    print(f"屏幕尺寸 / Screen size: {img.size}")
    print("测试完成 / Test complete.")
