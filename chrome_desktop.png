#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
visual_control.py
视觉控制一体化入口 / Unified Visual Control Entry

将视觉定位 + 鼠标键盘控制整合为单一接口。
Integrates visual locating + mouse/keyboard control into one API.

快速用法 / Quick usage:
  from visual_control import vc

  # 找到"保存"按钮并点击
  vc.click_on_text("保存")

  # 找到图标模板并点击
  vc.click_on_template("save_icon.png")

  # 混合定位后输入文字
  vc.locate_and_type("文件名", "hello_world")

  # 截图并保存用于验证
  vc.screenshot(save=True)
"""

import time
import logging
from typing import Optional, Tuple

from visual_locator import VisualLocator
from mouse_keyboard import DesktopController

log = logging.getLogger("VisualControl")


class VisualController:
    """
    视觉控制一体化控制器。
    All-in-one visual + input controller.
    """

    def __init__(
        self,
        ocr_lang: str = "chi_sim+eng",
        match_threshold: float = 0.8,
        human_like: bool = True,
        focus_lock: bool = True,
        default_retries: int = 3,
        retry_interval: float = 1.0,
    ):
        self.locator = VisualLocator(
            lang=ocr_lang,
            match_threshold=match_threshold,
            retry_interval=retry_interval,
        )
        self.ctrl = DesktopController(human_like=human_like, focus_lock=focus_lock)
        self.default_retries = default_retries

    # ── 定位并点击 / Locate & Click ───────────────

    def click_on_text(
        self,
        text: str,
        region: Optional[Tuple[int, int, int, int]] = None,
        retries: Optional[int] = None,
        button: str = "left",
        offset: Tuple[int, int] = (0, 0),
    ) -> bool:
        """
        通过 OCR 找文字并单击。
        Find text via OCR and click it.
        offset: (dx, dy) 相对偏移，用于点击文字旁的按钮
        """
        r = retries if retries is not None else self.default_retries
        pos = self.locator.locate(text, region=region, retries=r, strategy="ocr")
        if pos:
            x, y = pos[0] + offset[0], pos[1] + offset[1]
            self.ctrl.mouse.click(x, y, button=button)
            return True
        log.error(f"无法找到文字并点击: '{text}'")
        return False

    def click_on_template(
        self,
        template_path: str,
        region: Optional[Tuple[int, int, int, int]] = None,
        retries: Optional[int] = None,
        button: str = "left",
        offset: Tuple[int, int] = (0, 0),
    ) -> bool:
        """
        通过模板匹配找图标并单击。
        Find icon via template matching and click it.
        """
        r = retries if retries is not None else self.default_retries
        pos = self.locator.locate(
            "", template_path=template_path, region=region,
            retries=r, strategy="template",
        )
        if pos:
            x, y = pos[0] + offset[0], pos[1] + offset[1]
            self.ctrl.mouse.click(x, y, button=button)
            return True
        log.error(f"无法找到模板并点击: '{template_path}'")
        return False

    def click_hybrid(
        self,
        text: str,
        template_path: Optional[str] = None,
        region: Optional[Tuple[int, int, int, int]] = None,
        retries: Optional[int] = None,
        button: str = "left",
    ) -> bool:
        """
        混合策略：先模板匹配，失败再 OCR，带重试。
        Hybrid: try template first, fallback to OCR with retries.
        """
        r = retries if retries is not None else self.default_retries
        pos = self.locator.locate(
            text, template_path=template_path,
            region=region, retries=r, strategy="auto",
        )
        if pos:
            self.ctrl.mouse.click(pos[0], pos[1], button=button)
            return True
        log.error(f"混合定位失败: '{text}'")
        return False

    # ── 定位并输入 / Locate & Type ────────────────

    def locate_and_type(
        self,
        target: str,
        text: str,
        template_path: Optional[str] = None,
        region: Optional[Tuple[int, int, int, int]] = None,
        retries: Optional[int] = None,
        use_paste: bool = True,
        clear_first: bool = True,
    ) -> bool:
        """
        定位控件后点击并输入文字。
        Locate a control, click it, then type text.
        """
        r = retries if retries is not None else self.default_retries
        pos = self.locator.locate(
            target, template_path=template_path,
            region=region, retries=r,
        )
        if pos:
            self.ctrl.click_and_type(
                pos[0], pos[1], text,
                use_paste=use_paste,
                clear_first=clear_first,
            )
            return True
        log.error(f"定位并输入失败: '{target}'")
        return False

    # ── 截图与验证 / Screenshot & Verify ──────────

    def screenshot(
        self,
        region: Optional[Tuple[int, int, int, int]] = None,
        save: bool = True,
        filename: str = "",
    ):
        """截图并可选保存 / Take screenshot and optionally save."""
        return self.locator.screenshot(region=region, save=save, filename=filename)

    def verify_text_visible(
        self,
        text: str,
        region: Optional[Tuple[int, int, int, int]] = None,
    ) -> bool:
        """
        验证文字是否出现在屏幕上（用于操作后状态校验）。
        Verify that text is visible on screen (post-action check).
        """
        pos = self.locator.find_text(text, region=region)
        visible = pos is not None
        log.info(f"验证文字 '{text}': {'✅ 可见' if visible else '❌ 不可见'}")
        return visible

    # ── 常用快捷操作 / Common Shortcuts ───────────

    def press(self, key: str, presses: int = 1):
        """按键 / Press key."""
        self.ctrl.keyboard.press(key, presses=presses)

    def hotkey(self, *keys: str):
        """快捷键 / Hotkey combination."""
        self.ctrl.keyboard.hotkey(*keys)

    def type_text(self, text: str, use_paste: bool = True):
        """直接输入文字 / Directly type text."""
        self.ctrl.keyboard.type_text(text, use_paste=use_paste)

    def click_at(self, x: int, y: int, button: str = "left"):
        """在绝对坐标点击 / Click at absolute coordinates."""
        self.ctrl.mouse.click(x, y, button=button)

    def move_to(self, x: int, y: int):
        """移动鼠标 / Move mouse."""
        self.ctrl.mouse.move_to(x, y)

    def lock_focus(self, hwnd=None):
        """锁定窗口焦点 / Lock window focus."""
        self.ctrl.keyboard.lock_focus(hwnd)

    def unlock_focus(self):
        """解锁窗口焦点 / Unlock window focus."""
        self.ctrl.keyboard.unlock_focus()

    def wait(self, seconds: float):
        """等待指定秒数 / Wait for N seconds."""
        time.sleep(seconds)

    # ── Win 键打开应用 / Open App via Win Key ──────

    def open_app(
        self,
        app_name: str,
        wait_after: float = 5.0,
        max_wait: float = 15.0,
    ) -> bool:
        """
        通过 Win 键搜索并打开应用（无需知道安装路径）。
        Open an app by pressing Win key, typing the app name, and pressing Enter.

        流程 / Flow:
          1. 按 Win 键打开开始菜单
          2. 输入应用名称（支持中文）
          3. 等待搜索结果出现
          4. 按 Enter 打开第一个匹配结果
          5. 等待应用窗口出现

        :param app_name: 应用名称，如 "哔哩哔哩", "MATLAB", "Edge"
        :param wait_after: 打开后等待窗口出现的秒数
        :param max_wait: 最长等待窗口出现的秒数
        :return: 是否成功打开（检测到新窗口）
        """
        import pygetwindow as gw

        log.info(f"通过 Win 键打开应用: '{app_name}'")

        # 确保键盘状态干净
        self.ctrl.keyboard.unlock_focus()

        # 步骤1: 按 Win 键
        log.info("  按 Win 键打开开始菜单...")
        self.ctrl.keyboard.press("win")
        time.sleep(1.5)  # 等待开始菜单动画

        # 步骤2: 输入应用名称（用粘贴方式，支持中文）
        log.info(f"  输入应用名称: '{app_name}'")
        self.ctrl.keyboard.type_text(app_name, use_paste=True)
        time.sleep(2.0)  # 等待搜索结果

        # 步骤3: 按 Enter 打开第一个结果
        log.info("  按 Enter 打开...")
        self.ctrl.keyboard.press("enter")
        time.sleep(wait_after)

        # 步骤4: 验证窗口是否出现
        log.info("  验证应用窗口是否出现...")
        start_time = time.time()
        while time.time() - start_time < max_wait:
            windows = gw.getAllWindows()
            for w in windows:
                if app_name.lower() in w.title.lower() and w.visible:
                    log.info(f"  ✅ 应用窗口已出现: '{w.title}'")
                    return True
            time.sleep(1.0)

        log.warning(f"  未检测到应用窗口 '{app_name}'（可能已打开但标题不匹配）")
        return False

    def open_app_and_wait(
        self,
        app_name: str,
        window_title: str = "",
        wait_after: float = 5.0,
        max_wait: float = 20.0,
    ) -> Optional[int]:
        """
        通过 Win 键打开应用，并等待指定窗口出现，返回窗口句柄。
        Open app via Win key and wait for a specific window, return HWND.

        :param app_name: 传递给 open_app() 的应用名称
        :param window_title: 期望出现的窗口标题（模糊匹配），为空则匹配 app_name
        :param wait_after: 按 Enter 后等待秒数
        :param max_wait: 最长等待窗口出现的秒数
        :return: 窗口句柄 HWND，失败返回 None
        """
        import pygetwindow as gw

        log.info(f"通过 Win 键打开应用并等待窗口: '{app_name}'")

        self.open_app(app_name, wait_after=wait_after, max_wait=max_wait)

        # 等待窗口出现
        target = window_title if window_title else app_name
        log.info(f"  等待窗口标题包含: '{target}'")

        start_time = time.time()
        while time.time() - start_time < max_wait:
            windows = gw.getWindowsWithTitle(target)
            if windows:
                hwnd = windows[0]._hWnd
                log.info(f"  ✅ 窗口已找到: HWND={hwnd}, title='{windows[0].title}'")
                return hwnd
            time.sleep(1.0)

        log.warning(f"  超时：未找到窗口 '{target}'")
        return None


# ── 默认单例 / Default singleton ─────────────────
vc = VisualController()

if __name__ == "__main__":
    print("视觉控制模块已就绪 / Visual Control module ready.")
    print(f"屏幕尺寸 / Screen size: {__import__('pyautogui').size()}")
